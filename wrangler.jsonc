{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dhc6-trainer-website",
  "main": "worker.js",
  "compatibility_date": "2026-06-03",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "DESKTOP_RELEASE_VERSION": "1.7.0",
    "FIREBASE_PROJECT_ID": "dhc-6-trainer",
    "MOBILE_ANDROID_PACKAGE": "com.dhc6trainer",
    "OPENAI_MODEL": "gpt-4.1-mini",
    "PADDLE_ENVIRONMENT": "production",
    "PADDLE_SUCCESS_URL": "https://dhc6trainer.com/access.html?status=purchased&download=1#download"
  },
  "secrets": {
    "required": [
      "PADDLE_API_KEY",
      "PADDLE_WEBHOOK_SECRET",
      "LICENSE_SIGNING_SECRET",
      "OPENAI_API_KEY",
      "FIREBASE_WEB_API_KEY",
      "GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL",
      "GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY"
    ]
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // Outbound email (Cloudflare Email Service). Sends the welcome message that
  // carries a new subscriber's licence key - see functions/api/_welcome-email.js.
  //
  // Before this works in production: Cloudflare dashboard -> Compute -> Email
  // Service -> Email Sending -> Onboard Domain -> dhc6trainer.com. Cloudflare
  // adds the SPF, DKIM, DMARC and bounce MX records itself; the domain must be
  // on Cloudflare DNS, which it is. Requires the Workers Paid plan.
  //
  // Unset WELCOME_EMAIL_FROM defaults to noreply@dhc6trainer.com.
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "LICENSES",
      "id": "bf9eec9ca8e748ee8c6802751fafecaf"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DESKTOP_RELEASES",
      "bucket_name": "dhc6-trainer-private-releases"
    },
    {
      // Protected training media (GLB models, posters, cockpit plates).
      // Create before deploying: npx wrangler r2 bucket create dhc6-web-media
      "binding": "WEB_MEDIA",
      "bucket_name": "dhc6-web-media"
    },
    {
      // Library documents: the account's own uploads and the owner's published
      // shelf. Separate from WEB_MEDIA because these are user-supplied files
      // with their own retention and access rules, not built training assets.
      //
      // The binding is WEB_LIBRARY, not WEB_CONTENT, even though the bucket is
      // named dhc6-web-content: WEB_CONTENT is already claimed as an OPTIONAL KV
      // namespace by functions/api/content/_store.js and functions/api/media/_store.js
      // (`env.WEB_CONTENT || env.LICENSES`). Binding an R2 bucket to that name
      // would make both call .get() on a bucket and silently break the content
      // packs and the media index.
      //
      // Create before deploying: npx wrangler r2 bucket create dhc6-web-content
      "binding": "WEB_LIBRARY",
      "bucket_name": "dhc6-web-content"
    }
  ]
}
